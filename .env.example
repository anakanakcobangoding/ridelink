# Copy to apps/web/.env.local and apps/signaling/.env for local development.
# Production secrets and credentials belong in the deployment environment.

# Web app (apps/web)
# Set this to the public HTTPS Railway origin in Vercel (Socket.IO upgrades to WSS).
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4000
NEXT_PUBLIC_MAP_STYLE_URL=
# Public browser key; restrict allowed domains in the MapTiler dashboard.
NEXT_PUBLIC_MAPTILER_API_KEY=
# Server-only Vercel Function values. Never prefix these with NEXT_PUBLIC_.
OPENROUTESERVICE_API_KEY=
# Optional; defaults to the current HeiGIT ORS API host.
OPENROUTESERVICE_BASE_URL=https://api.heigit.org

# Signaling service (apps/signaling)
# Local fallback. Railway's injected PORT takes precedence.
SIGNALING_PORT=4000
# Comma-separated exact browser origins; add the Vercel production domain.
SIGNALING_CORS_ORIGIN=http://localhost:3000
ROOM_TTL_SECONDS=28800
ROOM_RECONNECT_GRACE_SECONDS=45
ROOM_MAX_PARTICIPANTS=2
SESSION_TOKEN_TTL_SECONDS=28800

# ICE configuration is served only to authenticated room participants.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=600
# TURN_SHARED_SECRET is the private coturn REST API shared secret.
# Never put TURN secrets in NEXT_PUBLIC_* variables.
